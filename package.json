{
  "name": "moy-nalog",
  "version": "2.0.0",
  "description": "Обёртка для API сервиса lknpd.nalog.ru",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "bun run build:js && bun run build:types",
    "build:js": "bun build src/index.ts --outfile dist/index.js --format esm --target node && bun build src/index.ts --outfile dist/index.cjs --format cjs --target node --footer \"module.exports = NalogAPI\"",
    "build:types": "tsc --emitDeclarationOnly && bun scripts/write-cjs-types.ts",
    "typecheck": "tsc --noEmit --pretty false",
    "lint": "biome check .",
    "test": "bun test",
    "smoke": "node scripts/smoke-node.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexstep/moy-nalog.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/alexstep/moy-nalog/issues"
  },
  "homepage": "https://github.com/alexstep/moy-nalog#readme",
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@types/node": "^24.5.2",
    "typescript": "^5.9.3"
  }
}
